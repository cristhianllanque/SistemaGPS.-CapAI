[Unit]
Description=Copay Telematics Backend & Teltonika TCP Service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/copay-telematics/backend
Environment="PATH=/home/ubuntu/copay-telematics/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/copay-telematics/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1

Restart=always
RestartSec=5s
KillMode=process

# Limits for high-concurrency GPS sockets
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
